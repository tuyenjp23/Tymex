# Sao chép file này thành ".env" rồi điền khóa của bạn. KHÔNG đưa file .env lên Git.

# Khóa API football-data.org (đăng ký miễn phí tại https://www.football-data.org/client/register)
FOOTBALL_DATA_API_KEY=

# Các giải đấu theo mã của football-data.org (gói miễn phí hỗ trợ: PL, PD, BL1, SA, FL1, CL, DED, PPL, ELC, BSA, EC, WC)
LEAGUES=PL,PD,BL1,SA,FL1

# Múi giờ hiển thị mặc định (có thể đổi ngay trên giao diện)
DEFAULT_TIMEZONE=Asia/Tokyo

# Đường dẫn file SQLite
DATABASE_PATH=data/football.db

# Tự động đồng bộ mỗi N phút khi đã có khóa API (0 = tắt, chỉ đồng bộ thủ công)
AUTO_SYNC_MINUTES=180

# Không gọi lại API cho cùng một giải nếu vừa đồng bộ trong N phút (trừ khi bấm "Ép cập nhật")
MIN_SYNC_INTERVAL_MINUTES=15

# Có tải thêm mùa giải trước để mô hình có nhiều dữ liệu hơn không (true/false)
SYNC_PREVIOUS_SEASON=true

# Giới hạn gói miễn phí football-data.org: 10 lần gọi/phút
RATE_LIMIT_PER_MINUTE=10

# (Tùy chọn) AI viết bài nhận định. Để trống nếu chưa dùng. Chỉ tốn phí khi bạn bấm "Viết bài bằng AI".
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
